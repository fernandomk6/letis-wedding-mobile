{
  "expo": {
    "name": "Letis Wedding",
    "slug": "letis-wedding-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.letiswedding.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o Letis Wedding acesse suas fotos para escolher a imagem do presente."
        }
      ],
      "expo-dev-client"
    ],
    "scheme": "letiswedding",
    "extra": {
      "eas": {
        "projectId": "842aaf41-9a3c-405a-b652-e57101915634"
      }
    },
    "owner": "fernandomk6"
  }
}
